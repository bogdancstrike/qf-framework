# ============================================================
# qf-template — environment configuration
# Copy this file to .env and edit before running.
# ============================================================

# ── Identity ─────────────────────────────────────────────────
APP_NAME=qf-template
SECRET_KEY=change-me-in-production

# ── API ──────────────────────────────────────────────────────
API_PORT=5000

# ── Kafka ─────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
WORKER_NAME=qf-template
ERROR_TOPIC=qf-template.dlq
KAFKA_COMMIT_STRATEGY=before

# Poll tuning — DEV defaults (see docs for PROD presets)
KAFKA_POLL_TIMEOUT_MS=1
KAFKA_POLL_MAX_RECORDS=200
KAFKA_IDLE_SLEEP_SEC=0
KAFKA_COMMIT_TICK_SEC=0.2
KAFKA_MAX_JOBS_PER_TP_PER_TICK=20

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5.0
REDIS_CONNECT_TIMEOUT=5.0
REDIS_RETRY_ON_TIMEOUT=true

# ── Postgres ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=qf
DB_USER=qf
DB_PASSWORD=qf

# ── Tracing (optional — requires Jaeger running) ──────────────
# Start Jaeger: docker compose up -d jaeger
# Then enable below and view traces at http://localhost:16686
ENABLE_TRACING=false
# OTLP_ENDPOINT=http://localhost:4317

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
# Set to true to log every HTTP request/response at DEBUG level
LOG_ENDPOINTS=false
