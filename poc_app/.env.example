# ====================================================
# SPECIFICS-FRAMEWORK-UTILS:
# ====================================================
# disable role checking (ONLY FOR DEV)
DISABLE_SECURITY=True

# disable kafka
DISABLE_KAFKA=false

# GENERICS
# ----------------------------------------------------
FLASK_APP=app.py
FLASK_DEBUG=development
# ----------------------------------------------------

# ====================================================
# DATABASES:
# POSTGRESS
# ----------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=qf
DB_USER=qf
DB_PASSWORD=qf
DB_TABLE_NAME=consumer_configs

# ====================================================
# ELASTICSEARCH
# ----------------------------------------------------
ELASTICSEARCH_CERT_PATH=./utils/es-cert.crt
ELASTICSEARCH_HOST=https://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme
ELASTICSEARCH_INDEX=workers

# ====================================================
# JAEGAR:
# ----------------------------------------------------
JAEGAR_AGENT_HOST_NAME=localhost
JAEGER_AGENT_PORT=6831
# ----------------------------------------------------

# ====================================================
# REDIS:
# ----------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=None
# Connection pool — tune max_connections to match your worker thread count
REDIS_MAX_CONNECTIONS=50
# Non-blocking: operations raise TimeoutError instead of hanging
REDIS_SOCKET_TIMEOUT=5.0
REDIS_CONNECT_TIMEOUT=5.0
# Retry once on timeout (safe for idempotent Lua scripts)
REDIS_RETRY_ON_TIMEOUT=true
# ----------------------------------------------------

# ====================================================
# KAFKA:
# ----------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
WORKER_NAME=poc-workers-app
ERROR_TOPIC=poc.dlq
KAFKA_COMMIT_STRATEGY=before

# ====================================================
# WORKER BASED:
# ----------------------------------------------------
WORKER_NAME=poc-workers-app
THREAD_POOL_SIZE=10

# ====================================================
# SESSION:
# ----------------------------------------------------
JWT_TOKEN_LOCATION=headers
SECRET_KEY=change-me-in-production

# ----------------------------------------------------
# CERTIFICATES AND KEYS:
# ----------------------------------------------------
CERTIFICATE_APP=tls/wildcard.cluster.local.crt
KEY_APP=tls/wildcard.cluster.local.key

# ====================================================
# CORS:
# ----------------------------------------------------
CORS_ALLOWED_ORIGINS="[
    '*'
]"

# ====================================================
# LOGS LEVEL
# CRITICAL, ERROR, WARNING, WARN, INFO, DEBUG, NOTSET
# ----------------------------------------------------
LOGGING_LEVEL=DEBUG

# ====================================================
# API
# ----------------------------------------------------
API_PORT=5000

# ====================================================
# TRACING (optional)
# Set ENABLE_TRACING=true and start Jaeger (docker-compose up -d jaeger)
# to see spans in the Jaeger UI at http://localhost:16686
# ----------------------------------------------------
ENABLE_TRACING=false
# QSINT_OTLP_ENDPOINT=http://localhost:4317

# ====================================================
# HTTP REQUEST LOGGING (optional)
# ----------------------------------------------------
LOG_ENDPOINTS=false
